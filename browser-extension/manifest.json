{
  "manifest_version": 3,
  "name": "MyPIU Sync",
  "description": "Refresh MyPIU from the PIUGAME session on this device.",
  "version": "0.2.0",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Sync MyPIU",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mypiu.austin.kim/*"],
      "js": ["src/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.piugame.com/*",
    "https://phoenix.piugame.com/*",
    "https://mypiu.austin.kim/*"
  ],
  "permissions": ["activeTab", "storage"],
  "web_accessible_resources": [
    {
      "resources": ["src/parser.js", "src/import-client.js", "src/sync-client.js"],
      "matches": ["https://mypiu.austin.kim/*"]
    }
  ]
}
